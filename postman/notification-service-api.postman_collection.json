        {
          "name": "Create Notification Immediate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 or 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "const expectedFields = [",
                  "    \"id\",",
                  "    \"recipient\",",
                  "    \"type\",",
                  "    \"message\",",
                  "    \"status\",",
                  "    \"createdAt\",",
                  "    \"subject\"",
                  "];",
                  "",
                  "pm.test(\"All expected fields are present\", function () {",
                  "    expectedFields.forEach(field => {",
                  "        pm.expect(response).to.have.property(field);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Status should not be PENDING\", function () {",
                  "    pm.expect(response.status).to.not.eql(\"PENDING\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
